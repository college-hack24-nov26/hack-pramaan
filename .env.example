# Server Configuration
PORT=8000
ENVIRONMENT=development

# Third-Party Weather & Soil APIs
METEOBLUE_API_KEY=your_meteoblue_api_key_here
CEHUB_API_KEY=your_cehub_api_key_here

# Google AI Studio / Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets / Apps Script Webhook
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_script_id/exec

# MongoDB Atlas Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.l4v0ldu.mongodb.net/pramaan_db?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=pramaan_db

# Twilio SMS OTP (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here
